# ─────────────────────────────────────────────────────────────────────────────
# Required — database and auth secrets.
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/flowcrm?sslmode=require&pgbouncer=true&connection_limit=5"
JWT_ACCESS_SECRET="generate-a-random-256bit-string-for-production"
JWT_REFRESH_SECRET="generate-a-different-random-256bit-string-for-production"

# ─────────────────────────────────────────────────────────────────────────────
# Server and CORS
# ─────────────────────────────────────────────────────────────────────────────
# PORT is the standalone backend port (default: 4000).
PORT=4000
# APP_PORT is the unified server port (frontend + API on one port, default: 3000).
# Only used by the root server.ts — ignored by the standalone backend.
# APP_PORT=3000
# CLIENT_ORIGIN is the single allowed CORS origin (fallback if CLIENT_ORIGINS is unset).
CLIENT_ORIGIN="http://localhost:3000"
# CLIENT_ORIGINS is a comma-separated list of allowed origins.
# When set, CLIENT_ORIGIN is ignored by CORS.
# CLIENT_ORIGINS="http://localhost:3000,https://your-production-domain.com"

# ─────────────────────────────────────────────────────────────────────────────
# Rate limiting
# ─────────────────────────────────────────────────────────────────────────────
# RATE_LIMIT_PER_MINUTE — global requests per IP per minute (default: 600).
# RATE_LIMIT_PER_MINUTE=600
# AUTH_RATE_LIMIT_PER_MINUTE — signup/login/refresh requests per IP per minute (default: 20).
# AUTH_RATE_LIMIT_PER_MINUTE=20

# ─────────────────────────────────────────────────────────────────────────────
# Dashboard
# ─────────────────────────────────────────────────────────────────────────────
# DASHBOARD_SUMMARY_CACHE_TTL_MS — how long the dashboard summary is cached (default: 15000).
# DASHBOARD_SUMMARY_CACHE_TTL_MS=15000

# ─────────────────────────────────────────────────────────────────────────────
# Node environment (development | production | test)
# ─────────────────────────────────────────────────────────────────────────────
# NODE_ENV=development
